# ===== Supabase (projetos separados: dev / homologação / produção) =====
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=chave-anon-publica   # pública por design; a segurança vem do RLS

# ===== Somente servidor — NUNCA prefixar com NEXT_PUBLIC_ =====
SUPABASE_SERVICE_ROLE_KEY=
# Segredo que autoriza o agendador externo (Vercel Cron / pg_cron+pg_net / n8n) a chamar /api/worker
CRON_SECRET=gere-com-openssl-rand-hex-32
# URL pública do app (links de proposta)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===== Integrações — PENDENTES (Fase 3). Vazias = integração desligada. =====
RD_STATION_CLIENT_ID=
RD_STATION_CLIENT_SECRET=
RD_CONVERSAS_API_TOKEN=
CLICKSIGN_ACCESS_TOKEN=
ZAPSIGN_API_TOKEN=
META_ADS_ACCESS_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
ASAAS_API_KEY=
ANTHROPIC_API_KEY=
# Prospecção
GOOGLE_PLACES_API_KEY=            # busca no Google Maps (Places API New) — servidor apenas
GOOGLE_PAGESPEED_API_KEY=         # opcional: nota de velocidade do site
RESEND_API_KEY=                   # envio de e-mail (domínio verificado com SPF/DKIM)
# Botão "Quero conversar" do diagnóstico público (opcionais; sem eles o botão não aparece). WhatsApp com DDI+DDD, só números.
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_EMAIL=
# Webhook de leads de anúncios (Meta Lead Ads via Make/Zapier/n8n): segredo longo e aleatório (ex.: openssl rand -hex 32)
LEADS_WEBHOOK_SECRET=
